{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qs4.me/schema/playlist.schema.json",
  "title": "Playlist",
  "description": "Система-плейлист (тематическая подборка вопросов). В отличие от sequential stream — порядок не важен, лента шафлится.",
  "type": "object",
  "required": ["slug", "category_slug", "name_ru", "description_ru"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "category_slug": {
      "type": "string",
      "enum": [
        "morning", "memory", "work", "creative", "reflection",
        "children", "social", "philosophy", "meta", "epistemology",
        "modelling", "linguistics", "senses", "imagination", "absurd"
      ]
    },
    "name_ru": { "type": "string", "minLength": 4, "maxLength": 40 },
    "description_ru": { "type": "string", "minLength": 16, "maxLength": 160 },
    "visibility": { "type": "string", "enum": ["public", "private"], "default": "public" },
    "is_system": { "type": "boolean", "default": true }
  }
}
